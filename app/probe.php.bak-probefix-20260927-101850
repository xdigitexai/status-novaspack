<?php
declare(strict_types=1);

require_once __DIR__ . '/lib.php';

/*
 * ============================================================================
 *  SITE PROBE SAFETY
 * ============================================================================
 *  A previous version of this dashboard executed live cron endpoints simply
 *  by fetching them (it ran a billing cycle and stopped customer bots).
 *
 *  Rules enforced here, in code:
 *    1. The ONLY HTTP method we ever send is HEAD (CURLOPT_NOBODY = true).
 *       A GET is never constructed anywhere in this codebase.
 *    2. The ONLY path we ever request is '/' — and even that has to be in the
 *       allowlist below and pass path_is_forbidden().
 *    3. No query strings, no redirects followed, no ports other than 80/443.
 *    4. Anything matching a scheduled/destructive shape is rejected outright.
 * ============================================================================
 */

const SITE_PROBE_ALLOWLIST = ['/', '/login', '/index.php'];

const SITE_PROBE_FORBIDDEN_SUBSTRINGS = [
    'cron_', 'cron-', '_verify', 'verify_', 'deduct', 'queue', 'worker',
    'deploy', 'webhook', 'callback', 'mutate', 'purge', 'flush', 'send',
    'settle', 'charge', 'bill', 'refund', 'payout', 'restart', 'delete',
];

function path_is_forbidden(string $path): bool
{
    $p = strtolower($path);
    if ($p === '' || $p[0] !== '/') {
        return true;                       // must be absolute
    }
    if (strpbrk($p, '?#') !== false) {
        return true;                       // never a query string or fragment
    }
    if (str_contains($p, '..') || str_contains($p, '//')) {
        return true;
    }
    if (str_contains($p, '/api/') || str_ends_with($p, '/api')) {
        return true;
    }
    if (preg_match('~\.[a-z0-9]{1,8}$~', $p) === 1 && !in_array($p, SITE_PROBE_ALLOWLIST, true)) {
        return true;                       // arbitrary script/asset filenames
    }
    foreach (SITE_PROBE_FORBIDDEN_SUBSTRINGS as $bad) {
        if (str_contains($p, $bad)) {
            return true;
        }
    }
    return false;
}

/** The single place in this codebase where a probe URL is constructed. */
function site_probe_url(string $scheme, string $host, string $path): string
{
    if (!in_array($scheme, ['http', 'https'], true)) {
        throw new RuntimeException('scheme not allowed');
    }
    if (!in_array($path, SITE_PROBE_ALLOWLIST, true)) {
        throw new RuntimeException('path not in allowlist');
    }
    if (path_is_forbidden($path)) {
        throw new RuntimeException('path forbidden');
    }
    if (preg_match('/^[a-z0-9]([a-z0-9._-]*[a-z0-9])?$/i', $host) !== 1) {
        throw new RuntimeException('host not allowed');
    }
    return $scheme . '://' . $host . $path;
}

function probe_paths(): array
{
    $allow = (array)(cfg('http')['allowlist'] ?? ['/']);
    if ((bool)(cfg('http')['probe_extra'] ?? false)) {
        return array_values(array_filter($allow, static fn($p) => !path_is_forbidden($p)));
    }
    return ['/'];
}

/**
 * HEAD-only HTTP probe of a batch of hostnames, over https first then http.
 * Returns host => ['status'=>int,'ms'=>int,'scheme'=>string,'error'=>string,'tls_days'=>?int]
 */
function http_probe_hosts(array $hosts): array
{
    $hcfg = cfg('http');
    $ct = (int)$hcfg['connect_timeout'];
    $to = (int)$hcfg['timeout'];
    $conc = max(1, (int)$hcfg['concurrency']);

    $res = [];
    foreach ($hosts as $h) {
        $res[$h] = ['status' => 0, 'ms' => 0, 'scheme' => '', 'error' => '', 'tls_days' => null];
    }
    if (!$hosts) {
        return $res;
    }

    foreach (['https', 'http'] as $scheme) {
        $todo = [];
        foreach ($hosts as $h) {
            if ($res[$h]['status'] === 0 && $res[$h]['scheme'] === '') {
                $todo[] = $h;
            }
        }
        if (!$todo) {
            break;
        }
        foreach (array_chunk($todo, $conc) as $chunk) {
            $batch = http_probe_chunk($chunk, $scheme, $ct, $to);
            foreach ($batch as $h => $r) {
                if ($r['status'] > 0) {
                    $res[$h] = $r;
                } elseif ($scheme === 'http') {
                    $res[$h] = $r;     // keep the http error; https already failed
                } elseif ($res[$h]['error'] === '') {
                    $res[$h]['error'] = $r['error'];
                }
            }
        }
    }
    return $res;
}

function http_probe_chunk(array $hosts, string $scheme, int $ct, int $to): array
{
    $out = [];
    foreach ($hosts as $h) {
        $out[$h] = ['status' => 0, 'ms' => 0, 'scheme' => '', 'error' => 'not attempted', 'tls_days' => null];
    }
    $paths = probe_paths();
    $path = $paths[0];

    $mh = curl_multi_init();
    $handles = [];
    foreach ($hosts as $host) {
        try {
            $url = site_probe_url($scheme, $host, $path);
        } catch (Throwable $e) {
            $out[$host]['error'] = 'blocked: ' . $e->getMessage();
            continue;
        }
        $ch = curl_init($url);
        curl_setopt_array($ch, [
            CURLOPT_NOBODY         => true,          // HEAD only — never GET
            CURLOPT_FOLLOWLOCATION => false,
            CURLOPT_MAXREDIRS      => 0,
            CURLOPT_CONNECTTIMEOUT => $ct,
            CURLOPT_TIMEOUT        => $to,
            CURLOPT_SSL_VERIFYPEER => false,
            CURLOPT_SSL_VERIFYHOST => 0,
            CURLOPT_CERTINFO       => true,
            CURLOPT_PROTOCOLS      => CURLPROTO_HTTP | CURLPROTO_HTTPS,
            CURLOPT_USERAGENT      => 'NovaOpsStatus/1.0 (read-only HEAD probe)',
            CURLOPT_HTTPHEADER     => ['Cache-Control: no-cache'],
        ]);
        $handles[$host] = $ch;
        curl_multi_add_handle($mh, $ch);
    }
    if (!$handles) {
        curl_multi_close($mh);
        return $out;
    }

    $active = null;
    do {
        $mrc = curl_multi_exec($mh, $active);
        if ($active) {
            curl_multi_select($mh, 0.25);
        }
    } while ($active && $mrc === CURLM_OK);

    foreach ($handles as $host => $ch) {
        $code = (int)curl_getinfo($ch, CURLINFO_RESPONSE_CODE);
        $ms = (int)round(((float)curl_getinfo($ch, CURLINFO_TOTAL_TIME)) * 1000);
        if ($code > 0) {
            $out[$host]['status'] = $code;
            $out[$host]['ms'] = $ms;
            $out[$host]['scheme'] = $scheme;
            $out[$host]['error'] = '';
            if ($scheme === 'https') {
                $out[$host]['tls_days'] = tls_days_from_handle($ch);
            }
        } else {
            $err = curl_error($ch);
            $out[$host]['error'] = $err !== '' ? $err : 'no response';
        }
        curl_multi_remove_handle($mh, $ch);
        curl_close($ch);
    }
    curl_multi_close($mh);
    return $out;
}

function tls_days_from_handle($ch): ?int
{
    $ci = curl_getinfo($ch, CURLINFO_CERTINFO);
    if (!is_array($ci)) {
        return null;
    }
    foreach ($ci as $cert) {
        if (!is_array($cert)) {
            continue;
        }
        foreach ($cert as $k => $v) {
            if (strcasecmp((string)$k, 'Expire date') === 0) {
                $ts = strtotime((string)$v);
                if ($ts) {
                    return (int)floor(($ts - time()) / 86400);
                }
            }
        }
    }
    return null;
}

